      "id": "1",
      "name": "Recibir resultado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "poketrivia-resultados"
    },
    {
      "parameters": {
        "jsCode": "const d=$json.body??$json; const req=['playerId','username','difficulty','score']; const missing=req.filter(k=>d[k]===undefined||d[k]===null||d[k]===''); const difficulty=String(d.difficulty??'').toLowerCase(); const score=Number(d.score); const validDifficulties=['principiante','avanzado','maestro']; const valid=missing.length===0&&Number.isFinite(score)&&score>=0&&validDifficulties.includes(difficulty); return [{json:{valid,missing,reason:missing.length?`Faltan datos: ${missing.join(', ')}`:(!Number.isFinite(score)||score<0?'La puntuación no es válida':(!validDifficulties.includes(difficulty)?'La dificultad no es válida':'')),result:{playerId:String(d.playerId??''),username:String(d.username??''),difficulty,generation:d.generation??null,score,correctAnswers:Number(d.correctAnswers??0),incorrectAnswers:Number(d.incorrectAnswers??0),questionsAnswered:Number(d.questionsAnswered??0),bestStreak:Number(d.bestStreak??0),hintsUsed:Number(d.hintsUsed??0),isNewRecord:Boolean(d.isNewRecord),subscription:d.subscription??'FREE',date:d.date??new Date().toISOString()}}}];"
      },
      "id": "2",
      "name": "Validar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valid }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "3",
      "name": "¿Resultado válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$json.result; const multiplier=r.bestStreak>=30?2:r.bestStreak>=20?1.75:r.bestStreak>=10?1.5:r.bestStreak>=5?1.25:1; return [{json:{...r,streakMultiplier:multiplier,status:r.isNewRecord?'new_record':'completed',processedAt:new Date().toISOString()}}];"
      },
      "id": "4",
      "name": "Procesar partida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isNewRecord }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "5",
      "name": "¿Nuevo récord?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{success:true,type:'new_record',message:'Resultado guardado y nuevo récord detectado.',...$json}}];"
      },
